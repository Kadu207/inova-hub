# Copiar na VPS para .env.prod — NÃO commitar segredos
COMPOSE_PROJECT_NAME=inovahub
APP_URL=https://inovahub.inovatitech.com.br
APP_KEY=
DB_DATABASE=inova_hub
DB_USERNAME=inova
DB_PASSWORD=

# Google Calendar OAuth (D29+) — injetado no container via docker-compose.prod.yml
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://inovahub.inovatitech.com.br/hub/google/callback
GOOGLE_CALENDAR_CONSENT_VERSION=gcal-1.0
